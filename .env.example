# Copy this file to .env and set your token.
# HF_TOKEN is required for the default pyannote diarization backend.
HF_TOKEN=hf_your_token_here

# pyannote is the quality-oriented default. speechbrain is an experimental local fallback.
CHATTERSPLIT_DIARIZER_BACKEND=pyannote

# Optional exact speaker count. Leave empty unless you know it.
CHATTERSPLIT_EXPECTED_SPEAKERS=

# Optional bounds when the exact speaker count is unknown.
CHATTERSPLIT_MIN_SPEAKERS=
CHATTERSPLIT_MAX_SPEAKERS=
